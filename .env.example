# The B7A6 backend's base API URL (server-side only - never exposed to the browser, since all
# client requests go through this app's own /api/proxy routes instead of hitting it directly).
BACKEND_API_URL=http://localhost:5000/api/v1

# One-click demo login credentials - these accounts must already exist in the backend.
# The backend's seed script only creates the admin account by default; register the
# customer/courier demo accounts once via /register before these buttons will work.
DEMO_ADMIN_EMAIL=admin@courier.com
DEMO_ADMIN_PASSWORD=Admin123!
DEMO_CUSTOMER_EMAIL=customer@test.com
DEMO_CUSTOMER_PASSWORD=password123
DEMO_COURIER_EMAIL=courier@test.com
DEMO_COURIER_PASSWORD=password123
